# Copy this file to the .env that your channel's config.json points at via
# "gemini_env_path" (see core/config.template.json's inline comments). Never
# commit the real file -- .env is already excluded in .gitignore.

# Gemini API key used by core/_gemini.py for chapter labeling, keyword
# clustering, and every other model call in this pipeline.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
